# Spirit O Santa – admin app environment. Copy to .env.local and fill in. NEVER commit .env.local.
# Production values go in Vercel → Project → Settings → Environment Variables.

# ── Database ─────────────────────────────────────────────────────────────────────────────
# MongoDB Atlas, cluster santaadmin.10ptpiw. Local: database "spiritofsanta_dev".
# Production (Vercel): database "spiritofsanta". Keep &appName=sos-<app> for Atlas metrics.
MONGODB_URI=

# ── Auth (NextAuth v4) ───────────────────────────────────────────────────────────────────
# A different random 32+ byte secret per app AND per environment (never reuse dev secrets).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=
# This app's public URL (also used to build links in emails this app sends).
# Local: http://localhost:3002   Production: https://admin.spiritofsanta.com
NEXTAUTH_URL=

# ── Email (Resend, verified sending domain fyht4.com) ────────────────────────────────────
# Resend → API Keys → "Sending access", restricted to fyht4.com. Development PRINTS emails
# to the terminal unless EMAIL_DEV_SEND=true; production always sends.
RESEND_API_KEY=
# Optional. Blank = "Spirit O Santa <no-reply@fyht4.com>".
RESEND_FROM=
# Optional. A monitored inbox that receives replies to our emails.
RESEND_REPLY_TO=

# ── Images (Vercel Blob, PUBLIC store; product/store photos only) ─────────────────────────
# Not secret. Lets <Image> show store photos (exact host allow-list in next.config).
BLOB_STORE_ID=
# ── Links to the store app (in invite / approval emails sent by admin) ───────────────────
# Local: http://localhost:3001   Production: https://store.spiritofsanta.com
STORE_APP_URL=
# ── Admin two-step sign-in (MFA) ───────────────────────────────────────────────────────────
# SECRET. Encrypts admins' authenticator secrets in the database. 32 random bytes, base64url:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use a DIFFERENT value in production. Keep it safe: if it's lost or changed, every admin must
# set up MFA again (run `npm run admin:create` for each). Never reuse NEXTAUTH_SECRET.
MFA_ENCRYPTION_KEY=
