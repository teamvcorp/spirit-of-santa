# Spirit O Santa – family app environment. Copy to .env.local and fill in. NEVER commit .env.local.
# Production values go in Vercel → Project → Settings → Environment Variables.

# ── Database ─────────────────────────────────────────────────────────────────────────────
# MongoDB Atlas, cluster santaadmin.10ptpiw. Local: database "spiritofsanta_dev".
# Production (Vercel): database "spiritofsanta". Keep &appName=sos-<app> for Atlas metrics.
MONGODB_URI=

# ── Auth (NextAuth v4) ───────────────────────────────────────────────────────────────────
# A different random 32+ byte secret per app AND per environment (never reuse dev secrets).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=
# This app's public URL (also used to build links in emails this app sends).
# Local: http://localhost:3000   Production: https://spiritofsanta.com
NEXTAUTH_URL=

# ── Email (Resend, verified sending domain fyht4.com) ────────────────────────────────────
# Resend → API Keys → "Sending access", restricted to fyht4.com. Development PRINTS emails
# to the terminal unless EMAIL_DEV_SEND=true; production always sends.
RESEND_API_KEY=
# Optional. Blank = "Spirit O Santa <no-reply@fyht4.com>".
RESEND_FROM=
# Optional. A monitored inbox that receives replies to our emails.
RESEND_REPLY_TO=

# ── Images (Vercel Blob, PUBLIC store; product/store photos only) ─────────────────────────
# Not secret. Lets <Image> show store photos (exact host allow-list in next.config).
BLOB_STORE_ID=
# ── Stripe (family app only; no Stripe Connect) ──────────────────────────────────────────
# Dashboard → Developers → API keys. Test keys locally, live keys in production.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Production: the whsec_ of the endpoint https://spiritofsanta.com/api/webhooks/stripe
# (Snapshot payload, API version 2026-09-30.endive, 10 events: see docs/vendor/stripe.md).
# Local: the secret printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=

# ── Later phases (leave blank for now) ───────────────────────────────────────────────────
# Phase 3/5: Twilio pay-later SMS.   Phase 7: push notifications.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
NEXT_PUBLIC_FCM_VAPID_PUBLIC_KEY=
FCM_VAPID_PRIVATE_KEY=