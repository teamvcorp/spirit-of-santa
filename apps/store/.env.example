# Copy to .env.local (git-ignored) and fill in. NEVER commit real values.
# Production values live in the Vercel project settings for this app.

# ── Shared by all three apps ─────────────────────────────────────────
# MongoDB Atlas connection string. Use a DB user scoped to this database only.
MONGODB_URI=
# Session signing/encryption key. Generate a separate one per app:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=
# Public origin of THIS app (sessions are host-only cookies, not shared across subdomains)
NEXTAUTH_URL=http://localhost:3001

# ── Store app ────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLOUDINARY_URL=
STRIPE_CONNECT_CLIENT_ID=
