{
  "name": "turboSanta",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "seed:dev": "node --conditions=react-server --env-file=apps/family/.env.local packages/auth/scripts/seed-dev.ts"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.20.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
