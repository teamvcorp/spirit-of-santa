{
  // Source package consumed only by the Next apps (no build step), so resolve like
  // Next's bundler and allow ".ts" extensions to match the other packages.
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
