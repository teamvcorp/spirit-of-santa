{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "MONGODB_URI",
    "MONGODB_DB",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL"
  ],
  "tasks": {
    "transit": {
      "dependsOn": [
        "^transit"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "env": [
        "NEXT_PUBLIC_*",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "FCM_VAPID_PRIVATE_KEY",
        "TWILIO_ACCOUNT_SID",
        "TWILIO_AUTH_TOKEN",
        "TWILIO_PHONE_NUMBER",
        "TWILIO_MESSAGING_SERVICE_SID",
        "TWILIO_API_KEY_SECRET",
        "TWILIO_API_KEY_SID",
        "BLOB_STORE_ID",
        "BLOB_READ_WRITE_TOKEN",
        "RESEND_API_KEY",
        "RESEND_FROM",
        "RESEND_REPLY_TO",
        "CRON_SECRET",
        "STORE_APP_URL",
        "FAMILY_APP_URL",
        "MFA_ENCRYPTION_KEY",
        "ADDRESS_ENCRYPTION_KEY",
        "FAMILY_PROMO_CODE",
        "DEED_QR_KEY"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "transit"
      ]
    },
    "check-types": {
      "dependsOn": [
        "transit"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "transit"
      ],
      "outputs": []
    },
    "@repo/i18n#test": {
      "dependsOn": [
        "transit"
      ],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/*/messages/**",
        "$TURBO_ROOT$/packages/*/messages/**",
        "$TURBO_ROOT$/packages/lib/src/**"
      ]
    }
  }
}
