{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV", "MONGODB_URI", "NEXTAUTH_SECRET", "NEXTAUTH_URL"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "NEXT_PUBLIC_*",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "FCM_VAPID_PRIVATE_KEY",
        "TWILIO_ACCOUNT_SID",
        "TWILIO_AUTH_TOKEN",
        "TWILIO_PHONE_NUMBER",
        "BLOB_STORE_ID",
        "BLOB_READ_WRITE_TOKEN",
        "RESEND_API_KEY",
        "RESEND_FROM",
        "RESEND_REPLY_TO",
        "CRON_SECRET",
        "STORE_APP_URL",
        "MFA_ENCRYPTION_KEY",
        "FAMILY_PROMO_CODE"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "check-types": {
      "dependsOn": ["transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    }
  }
}
